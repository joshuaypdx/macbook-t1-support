#!/usr/bin/env bash
# Protect a *proven working* kernel from APT autoremove. Does not hold updates,
# switch the default GRUB entry, or alter disk partitions/EFI.
set -Eeuo pipefail
STATE=/var/lib/mbp132-support
KNOWN=7.0.0-30-generic
command=${1:-status}
case "$command" in
  protect)
    [ "$(id -u)" -eq 0 ] || { echo 'Root privileges required.' >&2; exit 1; }
    [ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" = MacBookPro13,2 ] || exit 0
    [ -e "$STATE/attempted" ] || exit 0
    [ -f "/boot/vmlinuz-$KNOWN" ] || { echo "Proven kernel $KNOWN not present; cannot protect it." >&2; exit 1; }
    [ -d "/lib/modules/$KNOWN" ] || { echo "Modules directory missing for $KNOWN." >&2; exit 1; }
    # Require both installed DKMS modules before adopting the known-good baseline.
    for m in apple-ib-drv snd_hda_macbookpro; do
      dkms status -m "$m" -v 0.1 -k "$KNOWN" 2>/dev/null | grep -q ': installed' || {
        echo "Refusing to bless $KNOWN: $m is not installed for it." >&2; exit 1;
      }
    done
    # APT::NeverAutoRemove can be written safely from dpkg's postinst,
    # unlike apt-mark manual, which may contend with the package-manager lock.
    mkdir -p /etc/apt/apt.conf.d "$STATE"
    config=$(mktemp /etc/apt/apt.conf.d/99mbp132-protected-kernel.XXXXXX)
    cat > "$config" <<'APT'
// Generated by mbp132-support. Retain the one proven working fallback.
// This does not hold linux-generic or suppress security kernel updates.
APT::NeverAutoRemove {
  "^linux-image-7\\.0\\.0-30-generic$";
  "^linux-image-unsigned-7\\.0\\.0-30-generic$";
  "^linux-modules-7\\.0\\.0-30-generic$";
  "^linux-modules-extra-7\\.0\\.0-30-generic$";
  "^linux-headers-7\\.0\\.0-30-generic$";
  "^linux-headers-7\\.0\\.0-30$";
};
APT
    chmod 0644 "$config"
    mv -f "$config" /etc/apt/apt.conf.d/99mbp132-protected-kernel
    printf '%s\n' "$KNOWN" > "$STATE/known-good-kernel"
    chmod 644 "$STATE/known-good-kernel"
    echo "Protected the working $KNOWN kernel from autoremove using APT::NeverAutoRemove; ordinary security/kernel updates are NOT held."
    ;;
  status)
    if [ -f "$STATE/known-good-kernel" ]; then
      echo "Known-good fallback: $(cat "$STATE/known-good-kernel") (APT NeverAutoRemove rule installed)"
    else
      echo 'Known-good fallback: not yet protected.'
    fi
    ;;
  *) echo 'Usage: fallback protect|status' >&2; exit 2;;
esac
