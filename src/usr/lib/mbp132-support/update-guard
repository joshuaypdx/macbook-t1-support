#!/usr/bin/env bash
# Read-only monitoring of DKMS module presence for installed 7.0 Ubuntu kernels.
# Does NOT assert runtime safety, change GRUB, reload modules or install packages.
set -Eeuo pipefail
STATE=/var/lib/mbp132-support
KNOWN=7.0.0-30-generic
mode=${1:---report}
[[ "$mode" =~ ^--(apt|boot|report)$ ]] || { echo 'Usage: update-guard --apt|--boot|--report' >&2; exit 2; }
if [ ! -f "$STATE/attempted" ]; then
  [ "$mode" = --report ] && echo 'Hardware support not yet installed.'
  exit 0
fi
model=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
case "$model" in
  MacBookPro13,2) modules=(apple-ib-drv snd_hda_macbookpro);;
  MacBookPro13,3|MacBookPro14,2|MacBookPro14,3) KNOWN=; modules=(apple-ib-drv);;
  *) exit 0;;
esac
if [ -f "$STATE/install-model" ]; then
  [ "$(cat "$STATE/install-model")" = "$model" ] || exit 0
elif [ "$model" != MacBookPro13,2 ]; then
  exit 0
fi
issues=()
lines=()
current=$(uname -r)
lines+=("Running kernel: $current")
if [ -z "$KNOWN" ]; then
  lines+=("Touch Bar beta on $model: physical operation unverified.")
elif [ -f "$STATE/known-good-kernel" ]; then
  lines+=("Protected fallback: $(cat "$STATE/known-good-kernel")")
else
  issues+=("Known-good fallback kernel not yet protected.")
fi
# list candidate kernels that really have an installed boot image
shopt -s nullglob
kernels=()
for path in /boot/vmlinuz-*-generic; do
  k=${path#/boot/vmlinuz-}
  kernels+=("$k")
done
if [ "${#kernels[@]}" -eq 0 ]; then
  issues+=("No Ubuntu generic kernel images discovered.")
fi
# Check current and newest kernel plus protected baseline; old intermediate
# kernels need not carry DKMS builds. Do not mistake the mere existence of a
# newer image for a runtime-compatible kernel.
latest=$(printf '%s\n' "${kernels[@]}" | sort -V | tail -n 1)
selected=()
for k in "$KNOWN" "$current" "$latest"; do
  [ -n "$k" ] || continue
  case " ${selected[*]} " in *" $k "*) continue;; esac
  for existing in "${kernels[@]}"; do
    if [ "$existing" = "$k" ]; then selected+=("$k"); break; fi
  done
done
for k in "${selected[@]}"; do
  if ! [[ "$k" =~ ^7\.0\.0-[0-9]+-generic$ ]]; then
    issues+=("Kernel $k is OUTSIDE our supported 7.0.0-generic family. Keep a previously working boot option.")
    continue
  fi
  if [ -n "$KNOWN" ] && [[ "$k" == "$KNOWN" || "$k" == 7.0.0-43-generic ]]; then
    lines+=("$k: KNOWN WORKING on one 13,2 (user-tested, not independent certification)")
  else
    lines+=("$k: UNTESTED hardware runtime (even if DKMS builds)")
    issues+=("Kernel $k is untested with this profile; keep a previously working boot option.")
  fi
  for m in "${modules[@]}"; do
    state=$(dkms status -m "$m" -v 0.1 -k "$k" 2>/dev/null || true)
    if [[ "$state" == *': installed'* ]]; then
      lines+=("  $m DKMS: installed")
    else
      lines+=("  $m DKMS: MISSING or build failed")
      issues+=("$m is not DKMS-installed for $k. Use a previously working boot option until repaired.")
    fi
  done
  if [ -n "$KNOWN" ] && [ "$k" != "$KNOWN" ]; then
    # ABI-sensitive audio build must use the *exact* Ubuntu-patched source.
    imagever=$(dpkg-query -W -f='${Version}' "linux-image-$k" 2>/dev/null || true)
    srcver=$(dpkg-query -W -f='${Version}' linux-source-7.0.0 2>/dev/null || true)
    if [ -n "$imagever" ] && [ "$imagever" != "$srcver" ]; then
      issues+=("Kernel source mismatch for $k (image=$imagever; source=${srcver:-missing}). Audio build may be unsafe.")
    fi
  fi
done
if [ "${#issues[@]}" -eq 0 ]; then
  lines+=("DKMS presence checks: PASS. Physical audio/Touch Bar/suspend behavior NOT validated.")
else
  lines+=("WARNINGS:")
  for issue in "${issues[@]}"; do lines+=("- $issue"); done
fi
report=$(printf '%s\n' "${lines[@]}")
if [ "$mode" = --report ]; then
  printf '%s\n' "$report"
else
  # Do not fail apt transactions or block the boot on diagnostic issues.
  if [ "$(id -u)" -eq 0 ]; then
    mkdir -p "$STATE"
    printf '%s\n' "$report" > "$STATE/update-health.txt"
  fi
  if [ "${#issues[@]}" -gt 0 ]; then
    echo 'MacBook T1: module/kernel health warnings. Run: mbp132-support status' >&2
    command -v logger >/dev/null && logger -t mbp132-support "Module health warnings detected for $current" || true
  fi
fi
exit 0
